{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://minuano.dev/schema/event/v0.json",
  "title": "Minuano Event v0",
  "description": "Raw collected event. No enrichment applied at this stage.",
  "type": "object",
  "required": ["schema_version", "event_name", "event_timestamp", "anonymous_id", "session_id"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "type": "string", "const": "0" },
    "event_name": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,39}$" },
    "event_timestamp": { "type": "string", "format": "date-time" },
    "ingested_at": { "type": "string", "format": "date-time" },
    "anonymous_id": { "type": "string", "minLength": 8, "maxLength": 64 },
    "session_id": { "type": "string", "minLength": 8, "maxLength": 64 },
    "user_id": { "type": ["string", "null"], "maxLength": 128 },
    "page": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "url": { "type": "string" },
        "path": { "type": "string" },
        "title": { "type": "string" },
        "referrer": { "type": ["string", "null"] }
      }
    },
    "campaign": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source": { "type": ["string", "null"], "maxLength": 250 },
        "medium": { "type": ["string", "null"], "maxLength": 250 },
        "campaign": { "type": ["string", "null"], "maxLength": 250 },
        "content": { "type": ["string", "null"], "maxLength": 250 },
        "term": { "type": ["string", "null"], "maxLength": 250 },
        "attribution": { "type": "string", "enum": ["first_touch", "last_touch"] }
      }
    },
    "device": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "platform": { "type": "string", "enum": ["web", "android", "ios", "server"] },
        "user_agent": { "type": ["string", "null"] },
        "language": { "type": ["string", "null"] },
        "screen_width": { "type": ["integer", "null"] },
        "screen_height": { "type": ["integer", "null"] }
      }
    },
    "params": {
      "type": "object",
      "maxProperties": 25,
      "additionalProperties": { "type": ["string", "number", "boolean", "null"] }
    }
  }
}
